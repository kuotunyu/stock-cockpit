NODE_ENV=production
HOST=0.0.0.0
PORT=5174
APP_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PUBLIC_ORIGIN=
COOKIE_SECURE=true
DATA_DIR=/var/app/data
# 允許的 Host 名稱（逗號分隔，port 不比對）。預設只接受 127.0.0.1／localhost 與 LAN 模式
# 啟動時列舉到的本機位址；用自訂網域或 mDNS 名稱開啟時在這裡補上，否則會回 421。
ALLOWED_HOSTS=
# 只有放在反向代理後面才設 on：代理送來的 x-forwarded-proto／host／for 才會被採信。
TRUST_PROXY=off
# 收盤後排程：每 10 分鐘檢查一次，兩市場整批收盤對齊後自動掃描隔日沖／波段並推進驗證。
# 設 off 就回到「有人開 App 時才算」；伺服器沒開的日子不會有快照。
SCHEDULER=on
# 更新檢查：「更多 → 版本與更新」會向 GitHub 比對本機 commit 與 origin 分支（每 6 小時最多一次）。
# 設成 off 完全關閉；關掉之後本機 commit 仍看得到，只是不再跟上游對版。
UPDATE_CHECK=on
