# 本機 HTTP 範本。已存在 .env 時請直接編輯，勿覆蓋原有密鑰與資料路徑。
# HTTPS 部署設定見 README.md 的「環境變數說明」。
NODE_ENV=development
HOST=127.0.0.1
PORT=5174
APP_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PUBLIC_ORIGIN=
# 純 HTTP 本機／LAN 使用 false；HTTPS 部署才設 true。
COOKIE_SECURE=false
# 對外部署（Zeabur／反向代理）才設 on：除了健康探針與登入本身，所有 API 都要先登入，
# 未登入連唯讀行情也不給。本機／LAN 維持 off：看盤不必登入，登入只影響自選股同步與券商設定。
REQUIRE_LOGIN=off
# 登入有效期（毫秒），預設 14 天；對外站台可以設短一點。
SESSION_MAX_AGE_MS=
DATA_DIR=.data
# npm run backup 的預設備份目標（留空時必須從命令列傳入）。
STOCK1_BACKUP_DIR=
# 允許的 Host 名稱（逗號分隔，port 不比對）。預設只接受 127.0.0.1／localhost 與 LAN 模式
# 啟動時列舉到的本機位址；用自訂網域或 mDNS 名稱開啟時在這裡補上，否則會回 421。
ALLOWED_HOSTS=
# 只有放在反向代理後面才設：off（預設）｜on｜cloudflare。on 才採信代理送來的 x-forwarded-proto／host／for，
# 且一律取「最右邊的可信跳點」——代理是附加不是取代，最左段由客戶端自填，取第一段等於讓攻擊者決定限流鍵。
# cloudflare 模式優先用 cf-connecting-ip。
TRUST_PROXY=off
# 可信代理層數（on 模式取 x-forwarded-for 從右數第 N 段；只有一層代理就維持 1）。
TRUST_PROXY_HOPS=1
# 收盤後排程：每 10 分鐘檢查一次，兩市場整批收盤對齊後自動掃描隔日沖／波段並推進驗證。
# 設 off 就回到「有人開 App 時才算」；伺服器沒開的日子不會有快照。
SCHEDULER=on
# 更新檢查：「更多 → 版本與更新」會向 GitHub 比對本機 commit 與 origin 分支（每 6 小時最多一次）。
# 設成 off 完全關閉；關掉之後本機 commit 仍看得到，只是不再跟上游對版。
UPDATE_CHECK=on
